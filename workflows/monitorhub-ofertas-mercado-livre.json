        }
      },
      "id": "d373d75a-0cd9-4bd4-bcec-785802b10105",
      "name": "Buscar pagina de ofertas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Configuracao Ofertas').first().json;\nconst payload = $input.first()?.json || {};\nconst errors = [];\nif (payload?.error) errors.push(`n8n: falha ao consultar pagina de ofertas (${payload.error.message || payload.error}).`);\nif (payload?.message && Number(payload?.statusCode) >= 400) errors.push(`n8n: endpoint de ofertas retornou ${payload.statusCode}: ${payload.message}`);\nif (Array.isArray(payload?.errors)) errors.push(...payload.errors.map((message) => `n8n: ${message}`));\nconst products = Array.isArray(payload?.products) ? payload.products : [];\nreturn [{\n  json: {\n    runId: $execution?.id || `ofertas-${Date.now()}`,\n    source: 'n8n',\n    sourceName: 'Mercado Livre Ofertas',\n    query: 'Pagina publica de ofertas Mercado Livre',\n    currency: 'BRL',\n    products,\n    errors,\n    append: Boolean(cfg.appendFeed),\n    fetchedAt: payload.fetchedAt || new Date().toISOString(),\n    monitorHubEndpoint: cfg.monitorHubEndpoint,\n    monitorHubIngestToken: cfg.monitorHubIngestToken\n  }\n}];"
      },
      "id": "013e2b77-e5ad-44a6-bc1f-8a1c64210106",
      "name": "Preparar feed MonitorHub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.monitorHubEndpoint }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $json.monitorHubIngestToken ? 'Bearer ' + $json.monitorHubIngestToken : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { runId: $json.runId, source: $json.source, sourceName: $json.sourceName, query: $json.query, currency: $json.currency, products: $json.products, errors: $json.errors, append: $json.append, fetchedAt: $json.fetchedAt } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "bcb38fd4-7b7c-4fd0-a60d-ed0a66d10107",
      "name": "Enviar ofertas ao MonitorHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "content": "Este workflow coleta a pagina publica de Ofertas do Mercado Livre.\n\nA API do MonitorHub busca https://www.mercadolivre.com.br/ofertas, pagina por ?page=2, ?page=3 etc., extrai os cards e envia ao dashboard.\n\nAjuste pages/limit em offersSourceUrl para ampliar ou reduzir a coleta.",
        "height": 240,
        "width": 380,
        "color": 4
      },
      "id": "af704f94-d8e4-4c37-a356-8b4a51910108",
      "name": "Como funciona",
