      "id": "ac5d0a70-df94-499a-9548-826b2bd10104",
      "name": "Configuracao Ofertas",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -560,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.offersSourceUrl }}",
