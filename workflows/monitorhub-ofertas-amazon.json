              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "id": "aa5818ab-4f30-4a2b-9d50-3b9017150104",
      "name": "Configuracao Amazon",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -560,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.amazonDealsSourceUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "aa5818ab-4f30-4a2b-9d50-3b9017150105",
      "name": "Buscar ofertas da Amazon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Configuracao Amazon').first().json;\nconst payload = $input.first()?.json || {};\nconst errors = [];\nif (payload?.error) errors.push(`n8n: falha ao consultar ofertas da Amazon (${payload.error.message || payload.error}).`);\nif (payload?.message && Number(payload?.statusCode) >= 400) errors.push(`n8n: endpoint da Amazon retornou ${payload.statusCode}: ${payload.message}`);\nif (Array.isArray(payload?.errors)) errors.push(...payload.errors.map((message) => `n8n: ${message}`));\nconst products = Array.isArray(payload?.products) ? payload.products : [];\nreturn [{\n  json: {\n    runId: $execution?.id || `amazon-ofertas-${Date.now()}`,\n    source: 'n8n',\n    sourceName: 'Amazon Ofertas do Dia',\n    query: 'Pagina publica de Ofertas do Dia Amazon',\n    currency: 'BRL',\n    products,\n    errors,\n    append: Boolean(cfg.appendFeed),\n    fetchedAt: payload.fetchedAt || new Date().toISOString(),\n    monitorHubEndpoint: cfg.monitorHubEndpoint,\n    monitorHubIngestToken: cfg.monitorHubIngestToken\n  }\n}];"
      },
      "id": "aa5818ab-4f30-4a2b-9d50-3b9017150106",
      "name": "Preparar feed MonitorHub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.monitorHubEndpoint }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ $json.monitorHubIngestToken ? 'Bearer ' + $json.monitorHubIngestToken : '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { runId: $json.runId, source: $json.source, sourceName: $json.sourceName, query: $json.query, currency: $json.currency, products: $json.products, errors: $json.errors, append: $json.append, fetchedAt: $json.fetchedAt } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "aa5818ab-4f30-4a2b-9d50-3b9017150107",
      "name": "Enviar ofertas ao MonitorHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "content": "Este workflow coleta a pagina publica de Ofertas do Dia da Amazon.\n\nA API do MonitorHub abre https://www.amazon.com.br/deals, extrai o JSON inicial da pagina, pagina a API interna usada pela propria vitrine e envia os produtos reais ao dashboard.\n\nAjuste pages/limit em amazonDealsSourceUrl para ampliar ou reduzir a coleta.",
        "height": 260,
        "width": 420,
        "color": 5
      },
      "id": "aa5818ab-4f30-4a2b-9d50-3b9017150108",
