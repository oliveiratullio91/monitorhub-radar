      "id": "ad991919-6ba3-473c-8b01-8f4424720108",
      "name": "Buscar endpoint seguro de promocoes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        260
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Configuracao Promocoes').first().json;\nconst payload = $input.first()?.json || {};\nconst now = new Date().toISOString();\nconst errors = [];\n\nfunction basePayload(products = []) {\n  return {\n    runId: $execution?.id || `promocoes-${Date.now()}`,\n    source: 'n8n',\n    sourceName: 'Mercado Livre Promocoes',\n    query: 'Promocoes ativas Mercado Livre',\n    currency: 'BRL',\n    products,\n    errors,\n    fetchedAt: now,\n    monitorHubEndpoint: cfg.monitorHubEndpoint,\n    monitorHubIngestToken: cfg.monitorHubIngestToken\n  };\n}\n\nif (payload?.error) {\n  const detail = payload.error.message || payload.error.description || payload.error;\n  errors.push(`n8n: falha ao consultar endpoint seguro de promocoes (${detail}).`);\n}\n\nif (payload?.message && Number(payload?.statusCode) >= 400) {\n  errors.push(`n8n: endpoint seguro retornou ${payload.statusCode}: ${payload.message}`);\n}\n\nconst sourceErrors = Array.isArray(payload?.errors) ? payload.errors : [];\nerrors.push(...sourceErrors.map((message) => `n8n: ${message}`));\nconst products = Array.isArray(payload?.products) ? payload.products : [];\nreturn [{ json: basePayload(products) }];"
      },
