# Servidor local
PORT=8090

# Mercado Livre
# Crie uma aplicacao em https://developers.mercadolivre.com.br/ e gere um access token.
MERCADO_LIVRE_ENABLED=true
MERCADO_LIVRE_SITE_ID=MLB
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_REFRESH_TOKEN=
MERCADO_LIVRE_TOKEN_EXPIRES_AT=
MERCADO_LIVRE_USER_ID=
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=http://127.0.0.1:8090/api/mercadolivre/oauth/callback

# Amazon Creators API
# Requer conta Amazon Associates elegivel e credenciais da Creators API.
AMAZON_ENABLED=true
AMAZON_PROVIDER=creators
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_PARTNER_TAG=
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=

# Alternativa para Amazon: endpoint autorizado proprio/terceiro que retorne JSON.
# Use {{query}} e {{limit}} como placeholders se precisar.
AMAZON_ENDPOINT_URL=
AMAZON_ENDPOINT_AUTH_HEADER=

# Feed do n8n para alimentar o dashboard via POST /api/n8n/products.
# Opcional: se preenchido, o POST do feed, a avaliacao de alertas e a fila de notificacoes
# precisam enviar Authorization: Bearer <token> ou o header X-N8N-Token.
N8N_INGEST_TOKEN=

# Supabase - cadastro de usuarios e alertas personalizados.
# Pegue em Project Settings > API no seu projeto Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fila de notificacoes para o n8n
# GET /api/alerts/notifications lista notificacoes pendentes.
# PATCH /api/alerts/notifications com { "id": "...", "status": "sent" }
# ou { "id": "...", "status": "failed", "errorMessage": "..." } atualiza o envio.

# Disparo real de alertas
# POST /api/alerts/notifications envia notificacoes pendentes e atualiza a fila.
# Use ?evaluate=true para avaliar os alertas antes do envio.

# E-mail: escolha uma das opcoes abaixo.
EMAIL_PROVIDER=
EMAIL_FROM="Garimpanda <alertas@seudominio.com>"

# Opcao 1: Resend
RESEND_API_KEY=

# Opcao 2: SendGrid
SENDGRID_API_KEY=

# Opcao 3: SMTP/Gmail com senha de app
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Telegram opcional: copia operacional dos avisos enviados
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
