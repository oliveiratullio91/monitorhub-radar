{
  "rewrites": [
    {
      "source": "/api/catalog/products",
      "destination": "/api/products?catalog=1"
    },
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/site/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/site/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "/site/app.js"
    },
    {
      "source": "/entry.js",
      "destination": "/site/entry.js"
    },
    {
      "source": "/inicio.html",
      "destination": "/site/inicio.html"
    },
    {
      "source": "/produtos.html",
      "destination": "/site/produtos.html"
    },
    {
      "source": "/como-funciona.html",
      "destination": "/site/como-funciona.html"
    },
    {
      "source": "/radar.html",
      "destination": "/site/radar.html"
    },
    {
      "source": "/alertas.html",
      "destination": "/site/alertas.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/site/assets/:path*"
    },
    {
      "source": "/mercadolivre-setup.html",
      "destination": "/site/mercadolivre-setup.html"
    },
    {
      "source": "/mercadolivre-setup.js",
      "destination": "/site/mercadolivre-setup.js"
    }
  ]
}
